# Copy to .env and adjust.

# Access token for the web UI (leave empty to auto-generate into the data volume).
MERCHANDISER_TOKEN=

# --- External access: pick ONE ---
# A) HTTPS with your domain (recommended): DNS A record -> this server, open ports 80/443,
#    then: docker compose --profile https up -d
DOMAIN=
# B) Plain HTTP on all interfaces (token is sent unencrypted; use only on trusted networks):
# MERCHANDISER_BIND=0.0.0.0
# MERCHANDISER_PORT=8686

TZ=Asia/Shanghai

# DNS servers the container uses (defaults: 223.5.5.5, 119.29.29.29).
# MERCHANDISER_DNS1=192.168.3.1
# MERCHANDISER_DNS2=223.5.5.5
